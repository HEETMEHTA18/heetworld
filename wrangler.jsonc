{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "heetworld",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-28",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS"
  },
  "vars": {
    "CONTACT_FROM_EMAIL": "Heetworld Contact <onboarding@resend.dev>",
    "CONTACT_TO_EMAIL": "explore@heetworld.tech",
    "PUBLIC_ORIGIN": "https://heetworld.tech"
  },
  "observability": {
    "enabled": true
  }
}
